# Google Gemini API Key for AI-powered nerve segmentation analysis
GEMINI_API_KEY=your_gemini_api_key_here

# SQLite database file path (default: neurox.db in project root)
DATABASE_URL=neurox.db

# JWT secret for signing authentication tokens (use a long random string in production)
JWT_SECRET=neurox_super_secret_jwt_key_change_in_production

# Node environment: development | production
NODE_ENV=development
